{
  "_comment": "Repo-relative hook paths, deliberately. ${CLAUDE_PLUGIN_ROOT} does NOT resolve in a project's own .claude/settings.json — a hook command referencing it is skipped entirely, not run with an empty value. Verified on CLI 2.1.220: a literal command in the identical position fires, the ${CLAUDE_PLUGIN_ROOT} form produces no output at all, and absolute or relative paths both fire. This repo's hooks live in hooks/, so a repo-relative path is the simplest form that works.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "hooks/session-context.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "hooks/guard.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "hooks/rule-zero.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "hooks/format.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "hooks/verify-record.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "hooks/done-check.sh"
          }
        ]
      }
    ]
  }
}
