# Two-instance local stack.
#
# This is the point: one instance makes every statefulness bug invisible until
# production. Running two locally means a bug that only appears at scale appears
# on the first day instead.
#
# Use as the DEFAULT local stack for any project that will ever run more than
# one instance. Use docker-compose.yml (single) only for genuinely single-
# instance projects, and record that as a decision.

services:
  app-1:
    build: .
    environment:
      INSTANCE_ID: "1"
      DATABASE_URL: postgresql://dev:dev@postgres:5432/{{DB_NAME}}
      REDIS_URL: redis://redis:6379
    depends_on:
      postgres: { condition: service_healthy }
      redis:    { condition: service_started }

  app-2:
    build: .
    environment:
      INSTANCE_ID: "2"
      DATABASE_URL: postgresql://dev:dev@postgres:5432/{{DB_NAME}}
      REDIS_URL: redis://redis:6379
    depends_on:
      postgres: { condition: service_healthy }
      redis:    { condition: service_started }

  # Round-robins across both. Hit this, never an instance directly — hitting one
  # instance directly is how you accidentally test a single-instance system.
  lb:
    image: nginx:alpine
    ports: ["8080:80"]
    volumes: ["./scripts/nginx-lb.conf:/etc/nginx/conf.d/default.conf:ro"]
    depends_on: [app-1, app-2]

  postgres:
    image: postgres:16-alpine
    environment:
      POSTGRES_USER: dev
      POSTGRES_PASSWORD: dev
      POSTGRES_DB: {{DB_NAME}}
    ports: ["5432:5432"]
    volumes: ["pgdata:/var/lib/postgresql/data"]
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U dev"]
      interval: 5s
      retries: 10

  # Shared store for anything that would otherwise be per-instance:
  # sessions, cache, rate limits, locks, job queue.
  redis:
    image: redis:7-alpine
    ports: ["6379:6379"]

  # Migrations run ONCE, as their own step — never at app boot, where two
  # instances would race (ST-05).
  migrate:
    build: .
    command: {{MIGRATE_CMD}}
    environment:
      DATABASE_URL: postgresql://dev:dev@postgres:5432/{{DB_NAME}}
    depends_on:
      postgres: { condition: service_healthy }
    restart: "no"

volumes:
  pgdata:
